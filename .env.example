# INDEX Property Management - Environment Variables

# Database Configuration
DATABASE_URL=sqlite:///backend/data.db

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Stripe Billing Configuration
# Get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (created by stripe_setup.py script)
STRIPE_PRICE_CORE=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_PREMIUM=price_...

# Application Configuration
FRONTEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,https://your-app.railway.app

# Server Configuration
PORT=8000
